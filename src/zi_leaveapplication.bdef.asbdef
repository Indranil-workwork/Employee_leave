managed implementation in class zbp_zi_leaveapplication unique;
strict ( 2 );
with draft;

// ─────────────────────────────────────────────
// ROOT ENTITY — Leave Application
// ─────────────────────────────────────────────
define behavior for ZI_LeaveApplication
  alias LeaveApplication
  persistent table zleave_app_t
  draft table zleave_app_d
  lock master total etag LastChangedAt
  authorization master ( global )
  etag master LocalLastChangedAt
{
  field ( readonly, numbering:managed ) LeaveId;
  field ( mandatory ) EmployeeId;
  field ( mandatory ) LeaveType;
  field ( mandatory ) StartDate;
  field ( mandatory ) EndDate;
  field ( readonly )  Status;
  field ( readonly )  TotalDays;
  field ( readonly )  ApprovedBy;
  field ( readonly )  ApprovedAt;
  field ( readonly )  CreatedBy;
  field ( readonly )  CreatedAt;
  field ( readonly )  LastChangedBy;
  field ( readonly )  LastChangedAt;
  field ( readonly )  LocalLastChangedAt;

  create;
  update ( features : instance );
  delete ( features : instance );

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;

  // Root Prepare — root validations only
  // lock master privilege — child cannot have Prepare
  draft determine action Prepare
  {
    validation validateDates;
    validation validateEmployee;
    validation validateLeaveType;
  }

  determination setInitialStatus
    on modify { create; }

  determination calculateTotalDays
    on modify { field StartDate; field EndDate; }

  validation validateDates
    on save { create; update; field StartDate; field EndDate; }

  validation validateEmployee
    on save { create; field EmployeeId; }

  validation validateLeaveType
    on save { create; field LeaveType; }

  action ( features : instance ) submitLeave
    result [1] $self;

  action ( features : instance ) approveLeave
    result [1] $self;

  action ( features : instance ) rejectLeave
    result [1] $self;

  action ( features : instance ) withdrawLeave
    result [1] $self;

  association _Attachments { create; with draft; }

  mapping for zleave_app_t corresponding
  {
    LeaveId            = leave_id;
    EmployeeId         = employee_id;
    LeaveType          = leave_type;
    StartDate          = start_date;
    EndDate            = end_date;
    TotalDays          = total_days;
    Reason             = reason;
    Status             = status;
    ApprovedBy         = approved_by;
    ApprovedAt         = approved_at;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LastChangedBy      = last_changed_by;
    LastChangedAt      = last_changed_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}

// ─────────────────────────────────────────────
// CHILD ENTITY — Leave Attachment
// ─────────────────────────────────────────────
define behavior for ZI_LeaveAttachment
  alias Attachment
  persistent table zleave_attch_t
  draft table zleave_attch_d
  lock dependent by _Leave
  authorization dependent by _Leave
  etag master LocalLastChangedAt
{
  field ( readonly ) LeaveId;
  field ( readonly, numbering:managed ) AttachId;
  field ( mandatory ) FileName;
  field ( mandatory ) MimeType;
  field ( readonly )  CreatedBy;
  field ( readonly )  CreatedAt;
  field ( readonly )  LocalLastChangedAt;

  update ( features : instance );
  // create governed by parent association _Attachments { create; }
  delete;

  // No draft determine action Prepare here
  // lock dependent entities cannot declare Prepare
  // validateAttachment fires automatically via on save trigger

  // Fires on save when attachment is created
  // Validates MIME type, file name and file size
  validation validateAttachment
    on save { create; }

  association _Leave { with draft; }

  mapping for zleave_attch_t corresponding
  {
    LeaveId            = leave_id;
    AttachId           = attach_id;
    FileName           = file_name;
    MimeType           = mime_type;
    FileSize           = file_size;
    FileContent        = file_content;
    CreatedBy          = created_by;
    CreatedAt          = created_at;
    LocalLastChangedAt = local_last_changed_at;
  }
}